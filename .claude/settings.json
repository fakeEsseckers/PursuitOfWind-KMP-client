{
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(./scripts/check.sh:*)",
      "Bash(./scripts/setup.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(./scripts/build-demo-apk.sh:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/signing.properties)",
      "Edit(./.env)",
      "Edit(./**/*.jks)",
      "Edit(./**/*.keystore)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-kotlin.sh"
          }
        ]
      }
    ]
  }
}
