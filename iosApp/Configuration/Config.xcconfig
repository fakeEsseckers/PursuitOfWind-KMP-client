// Identity and version of the iOS app, shared by all build configurations.
// To run on a device, create Config.local.xcconfig next to this file (it is gitignored) with:
//   TEAM_ID = <your Apple developer team id>
// and, if the bundle id is taken under your team, BUNDLE_ID = <a unique id>.
TEAM_ID =
BUNDLE_ID = io.github.esseckers.pursuitofwind
APP_NAME = PursuitOfWind
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// The origin of the server this build talks to (no path). Empty runs the app on its in-app fake backend.
// A double slash starts a comment in this file, so write the address with an empty variable between the slashes:
//   API_BASE_URL = https:/$()/api.example.com
// Put it in Config.local.xcconfig to keep it out of the repository.
API_BASE_URL =

#include? "Config.local.xcconfig"
